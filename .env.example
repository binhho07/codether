# Copy to .env and adjust. Read by Docker Compose, apps/collab (node --env-file)
# and apps/web (Vite loads it from the repo root).

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=codether
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codether
# Host port for `compose.dev.yaml` (change if 5432 is already taken).
POSTGRES_PORT=5432
# Used by apps/collab when running on the host (from Phase 4 on).
DATABASE_URL=postgres://codether:change-me@localhost:5432/codether

# --- Collab server (apps/collab) ---------------------------------------------
COLLAB_HOST=0.0.0.0
COLLAB_PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Piston is only published on 127.0.0.1 by compose.dev.yaml; in containers
# collab uses http://piston:2000 on the internal network.
PISTON_URL=http://localhost:2000
# Comma-separated browser origins allowed to open WebSocket connections.
ALLOWED_ORIGINS=http://localhost:5173

# --- Web (apps/web) -----------------------------------------------------------
# Where the Vite dev server proxies /api and /collab.
COLLAB_PROXY_TARGET=http://localhost:4000
